<?xml version='1.0' encoding='utf-8'?>
<component type="desktop-application">
  <id>pl.fuzjajadrowa.pulsar</id>
  <name>Pulsar</name>
  <summary>Fast and modern media manager.</summary>
  <developer id="pl.fuzjajadrowa">
    <name>Fuzja Jadrowa</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>Pulsar is a desktop app for downloading media, converting formats, and compressing files.</p>
    <ul>
      <li>Download video and audio from yt-dlp supported services with advanced options.</li>
      <li>Convert media and files between multiple formats.</li>
      <li>Compress output with quality and size controls.</li>
      <li>Manage multiple processes in a queue.</li>
    </ul>
  </description>
