{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulsar",
  "version": "2.1.1",
  "identifier": "com.fuzjajadrowa.pulsar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pulsar",
        "width": 1000,
        "height": 700,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "icon": [
      "../src/assets/icons/icon.png",
      "../src/assets/icons/icon.icns",
      "../src/assets/icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Fuzja Jadrowa",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "../src/assets/icons/installer_icon.ico",
        "installerHooks": "./installer-hooks.nsh",
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGMTM3REVEQUUzRDY3RjUKUldUMVp6MnU3WDBURDZQSFFBdVNRdTgvdm1YeFpoZ25IcnZXYWQra1R5Qzd5enFmVXc0cW0yM0EK",
      "endpoints": [
        "https://raw.githubusercontent.com/FuzjaJadrowa/Pulsar/master/update.json"
      ]
    }
  }
}
