{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulsar",
  "version": "2.1.1",
  "identifier": "com.fuzjajadrowa.pulsar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pulsar",
        "width": 1000,
        "height": 700,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "../src/assets/icons/icon.png",
      "../src/assets/icons/icon.icns",
      "../src/assets/icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Fuzja Jadrowa",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://fuzjajadrowa.github.io/pulsar.json"
      ]
    }
  }
}