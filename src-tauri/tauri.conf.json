{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulsar",
  "version": "3.0.1",
  "identifier": "pl.fuzjajadrowa.pulsar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pulsar",
        "width": 1000,
        "height": 700,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": [30, 30, 30, 255],
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: data:; connect-src 'self' ipc: tauri:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "deb"],
    "icon": [
      "../public/assets/icons/icon.png",
      "../public/assets/icons/icon.icns",
      "../public/assets/icons/icon.ico"
    ],
    "resources": [
      "../public/assets/icons/icon.png"
    ],
    "copyright": "Copyright © 2026 Fuzja Jadrowa",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "../public/assets/icons/installer_icon.ico",
        "installerHooks": "nsis-hooks.nsi",
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGMTM3REVEQUUzRDY3RjUKUldUMVp6MnU3WDBURDZQSFFBdVNRdTgvdm1YeFpoZ25IcnZXYWQra1R5Qzd5enFmVXc0cW0yM0EK",
      "endpoints": [
        "https://raw.githubusercontent.com/FuzjaJadrowa/Pulsar/master/update.json"
      ]
    }
  }
}